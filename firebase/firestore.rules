rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == "admin";
    }

    function canEditCategory(category) {
      return isAdmin() ||
        (signedIn() &&
          userDoc().data.role == "editor" &&
          category in userDoc().data.permissions);
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if canEditCategory(request.resource.data.category);
      allow update: if canEditCategory(resource.data.category) &&
        canEditCategory(request.resource.data.category);
      allow delete: if canEditCategory(resource.data.category);
    }

    match /appSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }
  }
}
