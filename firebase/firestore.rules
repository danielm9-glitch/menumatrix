rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /menus/{menuId} {
      allow read, write: if request.auth != null;
    }
    match /menus/{workspaceId}/trainingAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.id == attemptId
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 20;
      allow update: if request.auth != null
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.id == attemptId
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 20;
      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow read, write: if request.auth != null;
    }

    match /app/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /menuShares/{shareCode} {
      allow read, write: if request.auth != null;
    }
  }
}
